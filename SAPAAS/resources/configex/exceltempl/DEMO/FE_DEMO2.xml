<?xml version="1.0" encoding="utf-8" ?>
<SRFEXGRIDEXCELEXPORT TEMPLATE="b.xls" SHOWCAPTION="TRUE" TEMPLATEROW="3">
	<SRFEXGRIDEXCELEXPORTCOLUMNS>
		<SRFEXGRIDEXCELEXPORTCOLUMN WIDTH="200" CAPTION="设备代码" ITEMFORMAT="#SRFDATAROWINDEX()_%1$s">
			<SRFEXITEMPARAMS>
				<SRFEXITEMPARAM ID="EquipCode" ItemFormat="%1$s" />
				<SRFEXITEMPARAM Id="EquipId" ItemFormat="%1$s"/>
				<SRFEXITEMPARAM Id="TechCode" ItemFormat="%1$s"/>
			</SRFEXITEMPARAMS>
		</SRFEXGRIDEXCELEXPORTCOLUMN >
		<SRFEXGRIDEXCELEXPORTCOLUMN  WIDTH="200" CAPTION="设备名称" COLUMNCOUNT="2" ID="EquipName" ItemFormat="%1$s">
			<SRFEXITEMPARAMS>
				<SRFEXITEMPARAM ID="EquipName" ItemFormat="%1$s" />
			</SRFEXITEMPARAMS>
		</SRFEXGRIDEXCELEXPORTCOLUMN>
		<SRFEXGRIDEXCELEXPORTCOLUMN  WIDTH="200" CAPTION="设备类型代码" ID="EqTypeId" ItemFormat="%1$s">
			<SRFEXITEMPARAMS>
				<SRFEXITEMPARAM ID="EqTypeId" ItemFormat="%1$s" />
			</SRFEXITEMPARAMS>
		</SRFEXGRIDEXCELEXPORTCOLUMN>
		<SRFEXGRIDEXCELEXPORTCOLUMN  WIDTH="150" CAPTION="设备类型名称" ID="EqTypeName" ItemFormat="%1$s">
			<SRFEXITEMPARAMS>
				<SRFEXITEMPARAM ID="EqTypeName" ItemFormat="%1$s" />
			</SRFEXITEMPARAMS>
		</SRFEXGRIDEXCELEXPORTCOLUMN>
		<SRFEXGRIDEXCELEXPORTCOLUMN  WIDTH="100" CAPTION="位置" ID="EmpName" ItemFormat="%1$s">
			<SRFEXITEMPARAMS>
				<SRFEXITEMPARAM ID="EmpName" ItemFormat="%1$s" />
			</SRFEXITEMPARAMS>
		</SRFEXGRIDEXCELEXPORTCOLUMN>
		
		<SRFEXGRIDEXCELEXPORTCOLUMN  WIDTH="100" CAPTION="值" ID="VALUE2" VALUE="1" CELLTYPE="NUMBER" />
		
		<SRFEXGRIDEXCELEXPORTCOLUMN  WIDTH="100" CAPTION="值2" ID="VALUE3" VALUE="1" CELLTYPE="NUMBER" />
		
		<SRFEXGRIDEXCELEXPORTCOLUMN  WIDTH="100" COLUMNCOUNT="2" CAPTION="值3" ID="VALUE4" VALUE="SUM(#SRFCELL(VALUE2):#SRFCELL(VALUE3))" CELLTYPE="FORMULA" />
			
	</SRFEXGRIDEXCELEXPORTCOLUMNS>
	<SRFEXGRIDEXCELEXPORTGROUPS>
	
		<SRFEXGRIDEXCELEXPORTGROUP  SORTDIRECTION="ASC" DATATYPE="VARCHAR">
			<SRFEXGRIDEXCELEXPORTGROUPBOTTOM TEMPLATEROW="6"  ROWCOUNT="2">
				<SRFEXGRIDEXCELEXPORTGROUPBOTTOMITEM COLUMN="4" ROW="1"   VALUE="SUM(#SRFGCELL(VALUE2))/5"  CELLTYPE="FORMULA"/>	
				<SRFEXGRIDEXCELEXPORTGROUPBOTTOMITEM COLUMN="5" ROW="1"   VALUE="#SRFOCELL(-1)+5"  CELLTYPE="FORMULA"/> 
				<SRFEXGRIDEXCELEXPORTGROUPBOTTOMITEM COLUMN="5" ROW="1"   VALUE="SUM(#SRFGCELL(VALUE4))"  CELLTYPE="FORMULA"/> 
				<SRFEXGRIDEXCELEXPORTGROUPBOTTOMITEM COLUMN="6" ROW="1"   VALUE="#SRFOCELL(-1)+#SRFOCELL(-3)"  CELLTYPE="FORMULA"/> 
			</SRFEXGRIDEXCELEXPORTGROUPBOTTOM>
		</SRFEXGRIDEXCELEXPORTGROUP>
		
		<SRFEXGRIDEXCELEXPORTGROUP DBFIELD="EqTypeName" SORTDIRECTION="ASC" DATATYPE="VARCHAR">
			 <SRFEXGRIDEXCELEXPORTGROUPHEADER ROWCOUNT="2" TEMPLATEROW="1" TEMPLATECOLUMNCOUNT="8" >
				<SRFEXGRIDEXCELEXPORTGROUPHEADERITEM COLUMN="0"   ItemFormat="设备代码名称： %1$s">
					<SRFEXITEMPARAMS>
						<SRFEXITEMPARAM ID="EqTypeName" ItemFormat="%1$s" />
					</SRFEXITEMPARAMS>
				</SRFEXGRIDEXCELEXPORTGROUPHEADERITEM>
				<SRFEXGRIDEXCELEXPORTGROUPHEADERITEM COLUMN="7"  COLUMNCOUNT="2" VALUE=""/>
			</SRFEXGRIDEXCELEXPORTGROUPHEADER> 
			<SRFEXGRIDEXCELEXPORTGROUPBOTTOM ROWCOUNT="2" TEMPLATEROW="4" >
				<SRFEXGRIDEXCELEXPORTGROUPBOTTOMITEM COLUMN="3" ROW="0"   VALUE="合计：" />
				<SRFEXGRIDEXCELEXPORTGROUPBOTTOMITEM COLUMN="4" ROW="1"   VALUE="SUM(#SRFGCELL(VALUE2))/5"  CELLTYPE="FORMULA"/>	
				<SRFEXGRIDEXCELEXPORTGROUPBOTTOMITEM COLUMN="5" ROW="1"   VALUE="#SRFOCELL(-1)+2"  CELLTYPE="FORMULA"/> 
				
			</SRFEXGRIDEXCELEXPORTGROUPBOTTOM>
		</SRFEXGRIDEXCELEXPORTGROUP>
		
	</SRFEXGRIDEXCELEXPORTGROUPS>
</SRFEXGRIDEXCELEXPORT>
