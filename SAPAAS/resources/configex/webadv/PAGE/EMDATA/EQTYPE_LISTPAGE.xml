<?xml version="1.0" encoding="utf-8" ?> 
<SRFADVLISTPAGE NEEDAUTH="FALSE" >
	<SRFADVWEBPARTS>
		<SRFADVWEBPART ID="SEARCHPANEL" CONFIG="EMDATAMGR.SP_EQTYPE" />
		<SRFADVWEBPART ID="dataGrid" LOADDEFAULT="FALSE" SELECTCOLUMN="TRUE" CONFIG="EMDATAMGR.DG_EQTYPE" />
		<SRFADVWEBPART ID="TABVIEW" CONFIG="EMDATAMGR.TABVIEW_EQTYPE_LIST" />
	</SRFADVWEBPARTS>
	
	<SRFADVBUTTONS>
		<SRFEXBUTTON ID="NewButton"  TEXT="新建" TIPS="新增" /> 
		<SRFEXBUTTON ID="EditButton"  TEXT="编辑" TIPS="编辑" /> 
		<SRFEXBUTTON ID="CopyButton"  TEXT="拷贝" TIPS="拷贝" /> 
		<SRFEXAJAXBUTTON ID="RemoveButton"  TEXT="删除" TIPS="删除" CONFIRM="确实要删除选中的数据么？"/> 
		<SRFEXBUTTON ID="Copy2Button"  TEXT="拷贝2" TIPS="拷贝2" /> 
		<SRFEXBUTTON ID="Copy3Button"  TEXT="拷贝3" TIPS="拷贝3" /> 
	</SRFADVBUTTONS>
	
	<SRFADVWEBGEARS>
	
		<SRFADVWEBGEAR ID="SP2DGGEAR" OBJECT="SP2DGGEAR" LOADMODE="FRONT" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="DATAGRIDID" VALUE="dataGrid" />
				<SRFADVWEBGEARPARAM ID="SEARCHPANELID" VALUE="SEARCHPANEL" />
			</SRFADVWEBGEARPARAMS>
		</SRFADVWEBGEAR>
	
		<SRFADVWEBGEAR ID="DATAGRIDAHREGHELPER" OBJECT="DATAGRIDAHREGHELPER" LOADMODE="BACKEND" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="DATAGRIDID" VALUE="dataGrid" />
				<SRFADVWEBGEARPARAM ID="ACTIONHELPER" VALUE="saeam.uihelper.datagrid.EQTypeGridHelper" />
			</SRFADVWEBGEARPARAMS>
		</SRFADVWEBGEAR>
		
		<SRFADVWEBGEAR ID="SEARCHPANELFORMAHREGHELPER" OBJECT="SEARCHPANELFORMAHREGHELPER" LOADMODE="BACKEND" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="SEARCHPANELID" VALUE="SEARCHPANEL" />
				<SRFADVWEBGEARPARAM ID="ACTIONHELPER" VALUE="saeam.uihelper.searchform.EQTypeSearchFormHelper" />
			</SRFADVWEBGEARPARAMS>							
		</SRFADVWEBGEAR>
		
		<SRFADVWEBGEAR ID="DG2TVGEAR" OBJECT="DG2TVGEAR" LOADMODE="FRONT" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="DATAGRIDID" VALUE="dataGrid" />
				<SRFADVWEBGEARPARAM ID="SELECTDATA" VALUE="{eqtypeid:_R.get('eqtypeid')}" />
			</SRFADVWEBGEARPARAMS>							
		</SRFADVWEBGEAR>
		
		<SRFADVWEBGEAR ID="DG2TVGEAR2" OBJECT="DG2TVGEAR" LOADMODE="FRONT" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="DATAGRIDID" VALUE="dataGrid" />
				<SRFADVWEBGEARPARAM ID="SELECTDATA" VALUE="{eqtypeid:_R.get('eqtypeid')}" />
				<SRFADVWEBGEARPARAM ID="TABVIEWID" VALUE="TABVIEW" />
			</SRFADVWEBGEARPARAMS>							
		</SRFADVWEBGEAR>
		
		<SRFADVWEBGEAR ID="DG2BUTTONSTATEGEAR" OBJECT="DG2BUTTONSTATEGEAR" LOADMODE="FRONT" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="DATAGRIDID" VALUE="dataGrid" />
				<SRFADVWEBGEARPARAM ID="BUTTONIDS" VALUE="EditButton;CopyButton;RemoveButton;Copy2Button;Copy3Button" />
			</SRFADVWEBGEARPARAMS>							
		</SRFADVWEBGEAR>
		
		<SRFADVWEBGEAR ID="DGNEWBUTTONGEAR" OBJECT="DGNEWBUTTONGEAR" LOADMODE="FRONT" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="DATAGRIDID" VALUE="dataGrid" />
				<SRFADVWEBGEARPARAM ID="BUTTONID" VALUE="NewButton" />
			</SRFADVWEBGEARPARAMS>							
		</SRFADVWEBGEAR>
		
		<SRFADVWEBGEAR ID="DGEDITBUTTONGEAR" OBJECT="DGEDITBUTTONGEAR" LOADMODE="FRONT" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="BUTTONID" VALUE="EditButton" />
			</SRFADVWEBGEARPARAMS>							
		</SRFADVWEBGEAR>
		
		
		<SRFADVWEBGEAR ID="DGCOPYBUTTONGEAR" OBJECT="DGCOPYBUTTONGEAR" LOADMODE="FRONT" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="DATAGRIDID" VALUE="dataGrid" />
				<SRFADVWEBGEARPARAM ID="BUTTONID" VALUE="CopyButton" />
			</SRFADVWEBGEARPARAMS>							
		</SRFADVWEBGEAR>
		
		<!-- 
			
			ENTITYKEYS	:实体键值，如果多个，使用 ; 进行分割
			CTRLACTION 	:执行操作
			INVALIDDATAKEYSMSG : 如果没有知道删除的数据，提示的错误信息
			CTRLACTION	:操作
		 -->
		<SRFADVWEBGEAR ID="DGREMOVEBUTTONGEAR" OBJECT="DGREMOVEBUTTONGEAR" >
			<SRFADVWEBGEARPARAMS>
				<SRFADVWEBGEARPARAM ID="DATAGRIDID" VALUE="dataGrid" />
				<SRFADVWEBGEARPARAM ID="BUTTONID" VALUE="RemoveButton" />
				<SRFADVWEBGEARPARAM ID="ENTITYKEYS" VALUE="EQTYPEID" />
				<SRFADVWEBGEARPARAM ID="CTRLACTION" VALUE="DBDELETECMD#EMEQTYPE.EMEQTYPE_DELETEEX" />
				<SRFADVWEBGEARPARAM ID="INVALIDDATAKEYSMSG" VALUE="没有指定数据的键值" />
			</SRFADVWEBGEARPARAMS>							
		</SRFADVWEBGEAR>
		
			
		
		
	</SRFADVWEBGEARS>
</SRFADVLISTPAGE>