<#ibiztemplate>
TARGET=PSSYSAPP
</#ibiztemplate>
{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true,
    "source.fixAll.stylelint": true,
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],
  "stylelint.validate": [
    "css",
    "less",
    "scss",
    "postcss"
  ],
  "stylelint.customSyntax": "postcss-scss"
}